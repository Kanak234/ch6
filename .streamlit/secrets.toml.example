# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Cloud > App settings > Secrets.
# NEVER commit the real secrets.toml (it is in .gitignore).
# OPTIONAL — live air data works without it (free Open-Meteo fallback).
# Google Maps Platform key with the "Air Quality API" enabled AND billing linked.
# GOOGLE_MAPS_API_KEY = "paste-your-google-maps-platform-key"
# Briefing + Q&A: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY = "paste-your-gemini-key"
# Optional: force a specific model ID; the defaults are tried after it.
# GEMINI_MODEL = "gemini-3.8-flash"
